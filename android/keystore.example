# Upload keystore for Play App Signing.
# Copy to android/keystore.properties and fill in. Never commit secrets or the .jks.
#
# Generate once:
#   keytool -genkey -v -keystore android/upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
#
# Paths for storeFile are relative to android/app/
storeFile=../upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
