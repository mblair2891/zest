# Summex — copy to .env (never commit secrets)

# --- App ---
# Public origin used in invite links, Stripe redirects, and Better Auth.
APP_URL=http://127.0.0.1:8080
BETTER_AUTH_URL=http://127.0.0.1:8080
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Postgres. Leave unset for local PGLite (embedded) fallback.
DATABASE_URL=

# Demo / quick-login + The Laundry TEST host (Steam Distillery, Diamond House BBQ).
# Production empty-start MUST use DEV_DEMO=0 (never seeds The Laundry).
DEV_DEMO=0
# Client bundle sees only VITE_* — keep this in sync with DEV_DEMO for UI gates.
VITE_DEV_DEMO=0

# Retired skip-password location picker. Leave off in production.
DEMO_OPEN_LOCATIONS=0
VITE_DEMO_OPEN_LOCATIONS=0

# First matching signup becomes platform_admin if none exists yet.
BOOTSTRAP_ADMIN_EMAIL=

# --- Auth (optional; Google/X via Grok broker when deployed) ---
# VITE_AUTH_ENABLED=false
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# --- SaaS billing (software fees ONLY — not POS card processing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_FULL_SERVICE=
STRIPE_PRICE_FOOD_HALL=
STRIPE_PRICE_PLATFORM_INTERNAL=

# --- AI interview (Stage A). Server-only; never VITE_ prefix. ---
# If unset, Get pricing uses a keyword heuristic ("Guided recommendations").
XAI_API_KEY=
# OPENAI_API_KEY=   # used only if XAI_API_KEY is empty

# --- Merchant card processing (Quantum Payments facade) ---
# Platform default is also sandbox (Platform → Payments). Training always sandboxes.
# live = card-present via the Quantum adapter (Stripe Terminal behind the host brand —
# never a Stripe/Square POS picker). Without keys + an enrolled reader, live fails
# closed: “Card requires connection” / take cash. Never stores PAN/CVV.
SUMMEX_PAYMENTS_MODE=sandbox
# Server-only live adapter secret (do not prefix VITE_). Optional fallback is unused
# if this is set. SaaS billing still uses STRIPE_SECRET_KEY separately.
QUANTUM_PAYMENTS_SECRET_KEY=
QUANTUM_PAYMENTS_WEBHOOK_SECRET=

# --- Public hosts (production DNS). Local/preview uses path prefixes instead. ---
# summex.app marketing + login + dashboard
# app.summex.app shared POS (no per-tenant subdomains)
# api.summex.app API
# sites.summex.app guest sites (custom domains later)
VITE_MARKETING_HOST=summex.app
VITE_APP_HOST=app.summex.app
VITE_API_HOST=api.summex.app
VITE_SITES_HOST=sites.summex.app
